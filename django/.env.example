# Configuración de Entorno - MoncoDairy API (Django + Firebase)
DEBUG=False
SECRET_KEY=reemplazar-por-clave-secreta-segura-de-al-menos-50-caracteres
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos relacional (PostgreSQL en producción / SQLite en desarrollo local)
# Ejemplo PostgreSQL: postgres://usuario:password@localhost:5432/moncodairy
DATABASE_URL=sqlite:///db.sqlite3

# Configuración de Firebase (Proyecto: appmoncopullisensores)
FIREBASE_PROJECT_ID=appmoncopullisensores
FIREBASE_DATABASE_URL=https://appmoncopullisensores-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=False
